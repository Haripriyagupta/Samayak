# ═══════════════════════════════════════
# Samayak Backend — Environment Variables
# ═══════════════════════════════════════
# Copy this file to ".env" and fill in your real values.
# NEVER commit the actual ".env" file to GitHub.

# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=samayak_db
DB_PORT=3306

# JWT Secret (used to sign login tokens)
# Generate a random string: in terminal run -> node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Gmail (for sending OTP emails)
# You CANNOT use your normal Gmail password — you must generate an "App Password".
# See SETUP_GUIDE.md for step-by-step instructions.
EMAIL_USER=youraddress@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password

# Frontend URL (for CORS)
FRONTEND_URL=http://127.0.0.1:5500
